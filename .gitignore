data/
*.json.backup

# Generated API types (regenerated via script)
# apps/web/lib/api.ts is committed, but generated types from script are not

# ============================================
# Keep these (do not ignore)
# ============================================
# !apps/web/lib/api.ts
# !apps/web/lib/types.ts
# !apps/api/app/models/__init__.py
# !packages/ui/src/tokens.css
# !packages/ui/src/index.ts
# !packages/tsconfig/base.json
# !pnpm-workspace.yaml
# !turbo.json
# !package.json
# !pnpm-lock.yaml
# !.env.example
# !.gitignore
# !README.md
# !AGENTS.md
# !docs/
# !assets/
# !.github/